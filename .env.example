# ============================================================
# GrowWise — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Your Supabase project URL (safe to expose to the browser).
# Find it in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anonymous / publishable key (safe to expose to the browser).
# Find it in: Supabase Dashboard → Project Settings → API → anon public
# (Newer Supabase dashboards label this key "Publishable key".)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# ── Gemini (server-side only — NEVER use NEXT_PUBLIC_ prefix) ──
# Your Gemini API key. Keep this server-side only.
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
